import { NextResponse } from 'next/server';
import { createClient } from '@supabase/supabase-js';

// 🌟 បិទการ Cache ដើម្បីឱ្យទិន្នន័យដัพเดតថ្មីជានិច្ច
export const dynamic = 'force-dynamic';

export async function GET(request: Request) {
  try {
    const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL!;
    const supabaseKey = 
      process.env.SUPABASE_SERVICE_ROLE_KEY || 
      process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY || 
      process.env.NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY!;
    
    const supabaseAdmin = createClient(supabaseUrl, supabaseKey, {
      auth: { persistSession: false }
    });

    // 🌟 ទាញយកទិន្នន័យចុងក្រោយបំផុតពីតារាង customer_subscriptions
    const { data, error } = await supabaseAdmin
      .from('customer_subscriptions')
      .select('email, client_name, access_token, page_id, page_name, ad_account_id, facebook_user_id')
      .not('access_token', 'is', null)
      .order('updated_at', { ascending: false })
      .limit(1);

    if (error || !data || data.length === 0) {
      return NextResponse.json({ connected: false });
    }

    const account = data[0];

    return NextResponse.json({
      connected: true,
      email: account.email,
      clientName: account.client_name,
      accessToken: account.access_token,
      pageId: account.page_id,
      pageName: account.page_name,
      adAccountId: account.ad_account_id,
      facebookUserId: account.facebook_user_id
    });

  } catch (error: any) {
    return NextResponse.json({ connected: false, error: error.message }, { status: 500 });
  }
}